# Single source of truth for every filesystem path in src/ and run/.
#
# Consumed by:
#   * shell   -- `set -a; source "$REPO_ROOT/src/paths.env"; set +a`
#   * python  -- src/project_paths.py  (shared_path / shared_name / repo_path)
#   * node    -- src/mechanisms/extract_pages.mjs  (loadPaths)
#
# Values may reference earlier keys as ${KEY}. Bash expands these natively on
# `source`; the Python and Node parsers implement the same forward-only rule, so
# a key must be defined ABOVE its first use. Nothing here may reference the
# environment -- only other keys in this file.
#
# Naming: *_DIR_REL / *_PATH_REL / *_FILE_REL / SIF_REL are relative to the repo
# root and MUST be used as "$REPO_ROOT/$KEY". C_* are absolute paths inside the
# container and are derived from their host counterpart, never hand-written --
# src/tests/unit_test_project_paths.py asserts the mirror holds.

# ---- host, relative to repo root ----
SRC_DIR_REL=src
RUN_DIR_REL=run
DATA_DIR_REL=data
TESTS_DIR_REL=${SRC_DIR_REL}/tests
RULES_DIR_REL=${SRC_DIR_REL}/data_generation/rules

PROCESSED_DIR_REL=${DATA_DIR_REL}/processed
FWD_DIR_REL=${PROCESSED_DIR_REL}/fwd
BWD_DIR_REL=${PROCESSED_DIR_REL}/bwd
PARQUET_DIR_REL=${DATA_DIR_REL}/nist_spectra
CSV_PATH_REL=${DATA_DIR_REL}/compounds.csv
MECHANISMS_DIR_REL=${DATA_DIR_REL}/mechanisms
MECHANISM_RECORDS_DIR_REL=${MECHANISMS_DIR_REL}/records
BOOK_DIR_REL=${DATA_DIR_REL}/IMS-Book
BOOK_PAGES_DIR_REL=${BOOK_DIR_REL}/pages

OUTPUTS_DIR_REL=${DATA_DIR_REL}/outputs
LOGS_DIR_REL=${OUTPUTS_DIR_REL}/logs
CHECKPOINT_DIR_REL=${OUTPUTS_DIR_REL}/checkpoints
PLOTS_DIR_REL=${OUTPUTS_DIR_REL}/plots
BEST_PARAMS_DIR_REL=${OUTPUTS_DIR_REL}/best_params
METRICS_DIR_REL=${OUTPUTS_DIR_REL}/metrics
MOD_POST_DIR_REL=${OUTPUTS_DIR_REL}/mod_post
WANDB_DIR_REL=${OUTPUTS_DIR_REL}/wandb

# SLURM log destinations. The matching `#SBATCH --output=` directive must repeat
# the literal (SLURM parses it before the shell runs); the guardrail test asserts
# the directive and the key agree.
DATAGEN_LOG_DIR_REL=${LOGS_DIR_REL}/data_gen/slurm
TRAIN_LOG_DIR_REL=${LOGS_DIR_REL}/train
OPTIM_LOG_DIR_REL=${LOGS_DIR_REL}/optim

FIGURES_DIR_REL=thesis/shared/figures
SECRETS_FILE_REL=.secrets/wandb.env
SIF_REL=mol-spectro.sif

# ---- container mirror (derived, never hand-written) ----
C_APP=/app
C_SRC=${C_APP}/${SRC_DIR_REL}
C_TESTS=${C_APP}/${TESTS_DIR_REL}
C_DATA=${C_APP}/${DATA_DIR_REL}
C_PROCESSED=${C_APP}/${PROCESSED_DIR_REL}
C_FWD=${C_APP}/${FWD_DIR_REL}
C_PARQUET=${C_APP}/${PARQUET_DIR_REL}
C_CSV=${C_APP}/${CSV_PATH_REL}
C_OUTPUTS=${C_APP}/${OUTPUTS_DIR_REL}
C_METRICS=${C_APP}/${METRICS_DIR_REL}
C_PLOTS=${C_APP}/${PLOTS_DIR_REL}
C_CHECKPOINTS=${C_APP}/${CHECKPOINT_DIR_REL}
C_BEST_PARAMS=${C_APP}/${BEST_PARAMS_DIR_REL}
C_MOD_POST=${C_APP}/${MOD_POST_DIR_REL}
C_WANDB=${C_APP}/${WANDB_DIR_REL}
