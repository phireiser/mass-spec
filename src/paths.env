# Shared relative paths for project directories
SRC_DIR_REL=src
RUN_DIR_REL=run
DATA_DIR_REL=data
PROCESSED_DIR_REL=data/processed
PARQUET_DIR_REL=outputs/nist_spectra
OUTPUTS_DIR_REL=outputs
LOGS_DIR_REL=outputs/logs
CHECKPOINT_DIR_REL=outputs/checkpoints
PLOTS_DIR_REL=outputs/plots
BEST_PARAMS_DIR_REL=outputs/best_params
PHASE0_DIR_REL=outputs/phase0
CSV_PATH_REL=data/compounds.csv

# Container-internal mount points (mirrors host structure under /app)
C_APP=/app
C_SRC=/app/src
C_DATA=/app/data
C_PROCESSED=/app/data/processed
C_PARQUET=/app/outputs/nist_spectra
C_OUTPUTS=/app/outputs
C_CSV=/app/data/compounds.csv
C_MOD_POST=/app/outputs/mod_post

# Container location
SIF=mol-spectro.sif
