# Shared relative paths for project directories
SRC_DIR_REL=src
RUN_DIR_REL=run
DATA_DIR_REL=data
PROCESSED_DIR_REL=data/processed
PARQUET_DIR_REL=data/nist_spectra
OUTPUTS_DIR_REL=data/outputs
LOGS_DIR_REL=data/outputs/logs
CHECKPOINT_DIR_REL=data/outputs/checkpoints
PLOTS_DIR_REL=data/outputs/plots
BEST_PARAMS_DIR_REL=data/outputs/best_params
METRICS_DIR_REL=data/outputs/metrics
CSV_PATH_REL=data/compounds.csv

# Container-internal mount points (mirrors host structure under /app)
C_APP=/app
C_SRC=/app/src
C_DATA=/app/data
C_PROCESSED=/app/data/processed
C_PARQUET=/app/data/nist_spectra
C_OUTPUTS=/app/data/outputs
C_CSV=/app/data/compounds.csv
C_MOD_POST=/app/data/outputs/mod_post

# Container location
SIF=mol-spectro.sif
