# Copyrighted reference material: the McLafferty textbook PDF plus scans of its
# endpaper/figures, kept locally as the provenance for the rules in
# src/data_generation/rules/IMS_*.py. Not redistributable, so not committed.
data/IMS-Book/

# Side-by-side rebuild of the dumps under the re-authored ruleset, kept while the
# baseline in data/processed/ is still the reference. Promote to data/processed/
# (which IS tracked) once the comparison is settled; do not commit both.
data/processed_reauth/

# The thesis tree is now merged into this repo under thesis/ (was a separate nested
# repo, gitignored while it lived here). It carries its own thesis/.gitignore, which
# git applies normally now that this directory is no longer excluded -- that nested
# file is what keeps LaTeX build artifacts and the copyrighted thesis/report/literature/
# PDFs out of the index. Do not re-add a "thesis/" line here: git does not descend into
# an excluded directory, so it would silently disable the nested rules along with it.
#
# EMBARGO: the thesis is unpublished and this repo's origin is PUBLIC. Any branch
# containing thesis/ must not be pushed to the public remote before publication.
_minted-main/**
_minted/
_minted-*/

# Per-agent staging area for in-progress mechanism records (validated, then promoted)
data/mechanisms/.staging/

# Side-by-side rebuild targets for A/B experiments (PROCESSED_DIR_OVERRIDE=...). These are
# throwaway derivation-graph dumps -- 2.2 GB across the four that exist today -- and only
# data/processed is the corpus of record.
data/processed*/
